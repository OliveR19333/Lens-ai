# GAS Property Mapping System — backend environment
# Copy to .env and fill in real values. Never commit .env.

# --- App ---
APP_NAME="GAS Property Mapping System"
ENV=development
API_HOST=0.0.0.0
API_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Auth (JWT) ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080          # 7 days (persistent field session)

# Single-user / small-team bootstrap credentials (Phase 1).
# Replace with a real user table before Phase 4 multi-user.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# --- Database (PostgreSQL + PostGIS) ---
DATABASE_URL=postgresql+psycopg2://gas:gas@localhost:5432/gas_mapping

# --- Celery / Redis ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
PARCEL_SYNC_CRON_DAY=1            # 1st of month
PARCEL_SYNC_CRON_HOUR=2           # 02:00 local

# --- Geocoding ---
CENSUS_GEOCODER_URL=https://geocoding.geo.census.gov/geocoder/locations/onelineaddress
CENSUS_BENCHMARK=2020
GOOGLE_MAPS_API_KEY=              # optional fallback; leave blank to disable

# --- WebODM ---
WEBODM_BASE_URL=http://localhost:8000/api
WEBODM_USERNAME=admin
WEBODM_PASSWORD=change-me

# --- Feature detection (Phase 3) ---
YOLO_MODEL_PATH=models/yolov8n-aerial-property.pt
FEATURE_MIN_CONFIDENCE=0.45

# --- Storage ---
STORAGE_DIR=./storage             # KMZ, GeoTIFF, PDF artifacts
DATA_DIR=./data                   # county GeoJSON bundles
